// Resource script for the controller ("RayNeo Spatial.exe").
//
// The icon is drawn procedurally at runtime (see ui_theme.cpp), so this file
// carries no binary assets: only the version block that Windows shows in the
// file properties and the manifest that requests per-monitor DPI awareness.
//
// The manifest is referenced by its numeric id (1 = CREATEPROCESS_MANIFEST_RESOURCE_ID,
// 24 = RT_MANIFEST) so the script does not depend on winuser.h being reachable.

#include <winver.h>

#define IDI_APP_ICON 101

1 24 "app.manifest"

IDI_APP_ICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RayNeo Spatial"
            VALUE "FileDescription", "RayNeo Spatial controller for the RayNeo GT"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "RayNeo Spatial"
            VALUE "LegalCopyright", "See docs/THIRD_PARTY_NOTICES.md"
            VALUE "OriginalFilename", "RayNeo Spatial.exe"
            VALUE "ProductName", "RayNeo Spatial"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
